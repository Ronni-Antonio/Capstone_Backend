[Unit]
Description=PLink CNN Classification API
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/plink-backend/PLink/ml_service
EnvironmentFile=/var/www/plink-backend/PLink/.env
ExecStart=/var/www/plink-backend/PLink/ml_service/cnn_venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:5002 --timeout 60 cnn_api:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
